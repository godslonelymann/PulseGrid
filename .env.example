# Generate secrets with: uv run python scripts/init-env.py
JWT_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-a-Fernet-key
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://pulsegrid:local-development-only@localhost:55432/pulsegrid
REDIS_URL=redis://localhost:56379/0
PUBLIC_ORIGIN=http://localhost:3000
# Required for Google sign-up and sign-in. OAuth client type: Web application. Redirect URI:
# http://localhost:3000/api/v1/auth/google/callback (use PUBLIC_ORIGIN in production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to false after you create your own account, so strangers cannot sign up on your server.
# Existing accounts can still sign in. Create or reset accounts with: python -m pulsegrid.manage
SIGNUPS_ENABLED=true
SECURE_COOKIES=false
ACCESS_SECONDS=300
SESSION_DAYS=14
WORKER_CONCURRENCY=20
LEASE_SECONDS=60
# Optional secret HTTPS ping URL for a 1-minute external worker heartbeat.
WORKER_HEARTBEAT_URL=
# Exact host:port entries only; empty by default. Permit only trusted targets.
PRIVATE_TARGET_ALLOWLIST=
RAW_RETENTION_DAYS=30
SECURITY_RETENTION_DAYS=90
INCIDENT_RETENTION_DAYS=365
# Required for signup confirmation, password reset, adding a password and email alerts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Optional daily off-server backup (AWS instance role + public age recipient).
BACKUP_S3_PREFIX=
BACKUP_AGE_RECIPIENT=
# Production HTTPS settings; use native PostgreSQL/Redis URLs above.
CADDY_ADDRESS=pulse.example.com
CADDY_EMAIL=operator@example.com
