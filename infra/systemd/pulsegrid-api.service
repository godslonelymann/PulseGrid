[Unit]
Description=PulseGrid API
After=network.target

[Service]
Type=simple
User=pulsegrid
Group=pulsegrid
WorkingDirectory=/opt/pulsegrid
Environment=ENV_FILE=/etc/pulsegrid/pulsegrid.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/pulsegrid/.venv/bin/python scripts/run-env.py /opt/pulsegrid/.venv/bin/uvicorn pulsegrid.api.main:app --host 127.0.0.1 --port 8000 --no-proxy-headers
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
MemoryMax=512M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
